# ---------------------------------------------------------------------------
# Docker image
# ---------------------------------------------------------------------------
BASE_IMAGE=zed_ros2_l4t_36.3.0_sdk_5.0.0
IMAGE_TAG=dev
CONTAINER_NAME=autonomypark-b1

# ---------------------------------------------------------------------------
# ROS 2 / DDS
# ---------------------------------------------------------------------------
ROS_DOMAIN_ID=0
ROS_LOCALHOST_ONLY=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# true:
#   Load config/fastdds/super_client_config.xml and connect as a
#   Fast DDS Discovery Server SUPER_CLIENT
#
# false:
#   Use normal Fast DDS discovery
USE_DISCOVERY_SERVER=true

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
LAUNCH_PLATFORM=true
PLATFORM=unitree
MODEL=b1
ROBOT_NAMESPACE=b1_165

# ---------------------------------------------------------------------------
# Sensors
# ---------------------------------------------------------------------------
LAUNCH_MICROSTRAIN=true

LAUNCH_EMLID=true

LAUNCH_ZED=true
ZED_MODEL=zed2i
ZED_CAMERA_NAME=zed
ZED_NAMESPACE=b1
ZED_SERIAL=12345678

LAUNCH_VELODYNE=true
VELODYNE_MODEL=VLP16
VELODYNE_RPM=600.0
VELODYNE_IP=192.168.3.201
VELODYNE_PORT=2368

# ---------------------------------------------------------------------------
# Holonomic Interpreter
# ---------------------------------------------------------------------------
LAUNCH_HOLO_INTERP=true
